<style>
  #shopify-section-{{ section.id }} {
    --section-products-per-row: 2;
  }
  @media screen and (max-width: 740px) {
  #shopify-section-{{ section.id }} .ap-productlist__inner {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 12px !important;
  }
}
  #shopify-section-{{ section.id }} .ap-productlist__inner {
    gap: calc(var(--container-distance) + var(--container-distance)) 0;
  }
@media screen and (min-width: 741px) and (max-width:1023px){
  #shopify-section-{{ section.id }} {
    --section-products-per-row: 4;
  }
}

/* ≥ 1024px */
@media screen and (min-width: 1024px)and (max-width:1399px) {
  #shopify-section-{{ section.id }} {
    --section-products-per-row: 6;
  }
}

/* ≥ 1400px */
@media screen and (min-width: 1400px) {
  #shopify-section-{{ section.id }} {
    --section-products-per-row: 6;
  }
}
  /*
    IMPLEMENTATION NOTE: due to design requirements, the mobile toolbar (with filters and sort by) had to be moved to the
    layout file. However as section settings cannot be accessed outside the section itself, we simply hide them in CSS.
   */

  .mobile-toolbar {
    display: none;
  }
  
#main-search-section .ap-productfacet__aside {
  display: none !important;
}

#main-search-section .ap-productfacet__main {
  margin-left: 20px;
}

/* --- Bandeau de recherche compact (rl-) --- */
#main-search-section .page-header--secondary {
  padding-top: 32px;
  padding-bottom: 24px;
}
#main-search-section .rl-search-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px 24px;
  flex-wrap: wrap;
  text-align: left;
}
#main-search-section .rl-search-title {
  font-size: clamp(22px, 4vw, 32px);
  line-height: 1.1;
  margin: 0;
}
#main-search-section .rl-search-count {
  font-size: 15px;
  color: #4f4f4f;
  margin: 6px 0 0;
}
#main-search-section .rl-search-refine {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0;
  width: 100%;
  max-width: 280px;
  padding: 6px 16px;
  background: #fff;
  border: 1px solid #dedede;
  border-radius: 24px;
  transition: border-color .15s ease, box-shadow .15s ease;
}
#main-search-section .rl-search-refine:focus-within {
  border-color: #ff6400;
  box-shadow: 0 0 0 3px rgba(255, 100, 0, .12);
}
#main-search-section .rl-search-refine__submit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  padding: 0;
  background: none;
  border: 0;
  color: #9a9a9a;
  cursor: pointer;
}
#main-search-section .rl-search-refine__input {
  flex: 1;
  min-width: 0;
  height: auto;
  padding: 2px 0;
  border: 0;
  outline: 0;
  background: transparent;
  box-shadow: none;
  font-size: 14px;
}
#main-search-section .rl-navtabs-hidden {
  display: none !important;
}

/* Compteur de la meta-bar : masqué visuellement, conservé pour les lecteurs d'écran */
#main-search-section .ap-productfacet__meta-bar {
  justify-content: flex-end;
}
#main-search-section .ap-productfacet__meta-bar-item--count {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

@media screen and (max-width: 740px) {
  #main-search-section .rl-search-header {
    flex-direction: column;
    align-items: stretch;
  }
  #main-search-section .rl-search-refine {
    max-width: none;
  }
}

</style>

<section id="main-search-section">
  <div class="page-header  page-header--secondary">
    <div class="page-header__text-wrapper container rl-search-header">
      <div class="rl-search-header__text">
        <h1 class="heading rl-search-title">{{ 'templates.search.main_title' | t }} "{{ search.terms | escape }}"</h1>
        <p class="rl-search-count">
          {{ search.results_count }} {% if search.results_count == 1 %}libro{% else %}libros{% endif %}
        </p>
      </div>

      <form class="rl-search-refine" action="/search" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="options[unavailable_products]" value="last">
        <button class="rl-search-refine__submit tap-area" type="submit" aria-label="Buscar">
          <svg focusable="false" width="16" height="16" class="icon icon--header-search" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M12.336 12.336c2.634-2.635 2.682-6.859.106-9.435-2.576-2.576-6.8-2.528-9.435.106C.373 5.642.325 9.866 2.901 12.442c2.576 2.576 6.8 2.528 9.435-.106zm0 0L17 17" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </button>
        <input class="rl-search-refine__input" type="text" name="q" autocomplete="off" autocorrect="off" aria-label="Buscar de nuevo" placeholder="Buscar de nuevo" value="{{ search.terms | escape }}">
      </form>

      {%- comment -%} Onglets masqués mais gardés : le JS d'Apollo en a besoin pour activer le panneau produits {%- endcomment -%}
      <ap-navtabs id="search-ap-navtabs" class="ap-navtabs ap-navtabs--center ap-navtabs--no-border ap-navtabs--edge2edge rl-navtabs-hidden" aria-hidden="true">
        <ap-scrollablecontent class="ap-navtabs__scroller hide-scrollbar">
          <div class="ap-navtabs__scroller-inner">
            <div class="ap-navtabs__item-list">
              <button class="ap-navtabs__item heading h4" data-type="product" ap-expanded-aria="true" ap-controlsaria="search-{{ section.id }}-product">Productos</button>
              <button class="ap-navtabs__item heading h4 d-none" data-type="article" ap-expanded-aria="false" ap-controlsaria="search-{{ section.id }}-article">Artículos</button>
            </div>
            <span class="ap-navtabs__position is-initialized"></span>
          </div>
        </ap-scrollablecontent>
      </ap-navtabs>
    </div>
  </div>
  <div class="{{ section.settings.setwidthout }}">
    <div class="page-content page-content--fluid">
      <search-page section-id="{{ section.id }}" terms="{{ search.terms | escape }}" complete-for='["","article","page"]' class="main-search__results">
        <div id="search-{{ section.id }}-product" class="main-search__category-result">
          <style>
            .mobile-toolbar,
            .mobile-toolbar__item--filters {
              display: flex;
            }

            .mobile-toolbar,
            .mobile-toolbar__item--sort {
              display: flex;
            }

            @media screen and (max-width: 999px) {
              :root {
                --anchor-offset: 60px;
              }
            }
          </style>
          
          {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}

          <ap-productfacet section-id="{{ section.id }}" class="ap-productfacet">
            {% render 'product-filter', sort_by: sort_by %}
            
            <div id="facet-main" class="ap-productfacet__main anchor" role="region" aria-live="polite">
              <div class="ap-productfacet__meta-bar anchor">
                <span class="ap-productfacet__meta-bar-item ap-productfacet__meta-bar-item--count" role="status">{{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}</span>
                <div class="ap-productfacet__meta-bar-item ap-productfacet__meta-bar-item--sort">
                  <span class="ap-productfacet__sort-by-title text--subdued hd-pocket">{{ 'products.facets.sort_by_label' | t }}</span>
                  <div class="popover-container">
                    <button type="button" is="toggle-button" class="popover-button hd-pocket" ap-expanded-aria="false" ap-controlsaria="ap-sortbypopover">
                      <span id="sort-by-selected-value" style="pointer-events: none">Relevancia</span>
                      <svg focusable="false" width="12" height="8" class="icon icon--chevron icon--inline  " viewBox="0 0 12 8">
                        <path fill="none" d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="2"></path>
                      </svg>
                    </button>
                    <ap-sortbypopover id="ap-sortbypopover" class="popover">
                      <span class="popover__overlay"></span>
                      <header class="popover__header">
                        <span class="popover__title heading h6">{{ 'products.facets.sort_by_label' | t }}</span>
                        <button type="button" class="popover__close-button tap-area tap-area--large" data-action="close" title="Close">
                          <svg focusable="false" width="14" height="14" class="icon icon--close   " viewBox="0 0 14 14">
                            <path d="M13 13L1 1M13 1L1 13" stroke="currentColor" stroke-width="2" fill="none"></path>
                          </svg>
                        </button>
                      </header>
                      <div class="popover__content">
                        <div class="popover__choice-list"> {%- assign sort_by = search.sort_by | default: search.default_sort_by -%} {%- for option in search.sort_options -%} <label class="popover__choice-item">
                            <input type="radio" data-bind-value="sort-by-selected-value" class="visually-hidden" {% if option.value == sort_by %}checked="checked" {% endif %} name="sort_by" value="{{ option.value | escape }}" title="{{ option.name | escape }}">
                            <span class="popover__choice-label">{{ option.name | escape }}</span>
                          </label> {%- endfor -%} </div>
                      </div>
                    </ap-sortbypopover>
                  </div>
                </div>
              </div>
              {% paginate search.results by 48 %}
                <ap-productlist stagger-apparition="" class="ap-productfacet__ap-productlist ap-productlist ap-object-loaded" role="region" aria-live="polite" style="opacity: 1;">
                  <div class="ap-productlist__inner"> 
                    {%- for item in search.results -%} 
                      {%- case item.object_type -%} 
                        {%- when 'product' -%} 
                          {% render 'product-grid', product: item %} 
                      {%- endcase -%} 
                  {%- endfor -%} 
                  </div>
                </ap-productlist>
                {%- if paginate.pages > 1 -%} {% render 'pagination', paginate: paginate %} {%- endif -%} 
              {% endpaginate %}
            </div>
          </ap-productfacet>
        </div>
        
        <div id="search-{{ section.id }}-article" class="main-search__category-result" data-label="Article">
          <ap-listarticle stagger-apparition="" class="ap-listarticle ap-listarticle--stacked ap-object-loaded">
            {% paginate search.results by 4 %}
              {%- for item in search.results -%} 
                {%- case item.object_type -%} 
                  {%- when 'article' -%}
                    {% render 'blog-grid', article: item %} 
                {%- endcase -%} 
              {%- endfor -%} 
            {% endpaginate %}
          </ap-listarticle>
        </div>
      </search-page>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "shopify-section--main-search",
  "settings": [
    {
      "type": "select",
      "id": "setwidthout",
      "label": "Width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Box"
        },
        {
          "value": "container-fluid",
          "label": "Container Fluid"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    }
  ]
}
{% endschema %}
